			},
			{
				"name": "VerifyCardDetail",
				"description": "Verifies a field value displayed inside a related list card (preview card layout).\r\nLocates the card by its aria-label, finds the specific item by name, then reads the field value.\r\n@param cardName Name of the related list card (matches aria-label on the article element, e.g. \"Products\").\r\n@param itemName Name of the item within the card (e.g. \"AutoProduct Basic\"). Used to scope the lookup when multiple items exist.\r\n@param fieldName Label of the field to verify (e.g. \"Sales Price\", \"Quantity\", \"Stage\").\r\n@param value Expected value text.\r\n",
				"type": "",
				"returns": "",
				"signature": "/**string*/ cardName, /**string*/ itemName, /**string*/ fieldName, /**string*/ value",
				"paramInfo": {},
				"src": "%WORKDIR%PageObjects\\Sfdc\\Sfdc.js(432,10)"
			},
			{
				"name": "SearchTable",
				"description": "Searches data in a table.\r\n",
				"type": "",
				"returns": "",
				"signature": "/**string*/ value",
				"paramInfo": {},
				"src": "%WORKDIR%PageObjects\\Sfdc\\Sfdc.js(512,10)"
			},
			{
				"name": "SelectComboboxItem",
				"description": "Selects item from a combobox.\r\nSupports Lightning combobox (lightning-combobox), classic Aura picklist (forceInputPicklist),\r\nand native HTML select elements (uiInputSelect).\r\n@param item Item name.\r\n@param name Name of a combobox.\r\n",
				"type": "",
				"returns": "",
				"signature": "/**string*/ name, /**string*/ item",
				"paramInfo": {},
