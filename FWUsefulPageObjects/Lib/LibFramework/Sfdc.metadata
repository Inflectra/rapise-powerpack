			},
			{
				"name": "SelectInnerTab",
				"description": "Selects inner tab.\r\n@param name Tab name (e.g. Details, Activity).\r\n",
				"type": "",
				"returns": "",
				"signature": "/**string*/ name",
				"paramInfo": {},
				"src": "%WORKDIR%PageObjects\\Sfdc\\Sfdc.js(662,10)"
			},
			{
