			},
			{
				"name": "AddReportFilter",
				"description": "Adds a report filter (a.g. \"Account Name\" contains \"Auto\").\r\n@param filter Filter name (e.g. Account Name).\r\n@param operator Operator to use (e.g. contains).\r\n@param value Input value for the filter.\r\n",
				"type": "",
				"returns": "",
				"signature": "/**string*/ filter, /**string*/ operator, /**string*/ value",
				"paramInfo": {},
				"src": "%WORKDIR%PageObjects\\Sfdc\\Sfdc.js(706,10)"
			},
			{
				"name": "FormatDate",
				"description": "Computes a date relative to today (or a given base) and returns it formatted\r\nfor Salesforce date input fields.\r\n@param offsetDays Number of days to add (can be negative). Default 0.\r\n@param baseDate Base date string (ISO format \"yyyy-MM-dd\") or \"today\". Default \"today\".\r\n@returns Formatted date string ready for SetTextField.\r\nUsage:\r\nSfdc.FormatDate(60);              // today + 60 days\r\nSfdc.FormatDate(7, \"today\");      // today + 7 days\r\nSfdc.FormatDate(0, \"2026-01-15\"); // specific date, no offset\r\nSfdc.SetTextField(\"Close Date\", LastResult);\r\n",
				"type": "",
				"returns": "",
				"signature": "/**number*/ offsetDays, /**string*/ baseDate",
				"paramInfo": {},
				"src": "%WORKDIR%PageObjects\\Sfdc\\Sfdc.js(799,10)"
			},
			{
				"name": "RelatedListAction",
				"description": "Clicks an action from a Related List's dropdown menu.\r\nLocates the related list by its aria-label, opens the dropdown trigger,\r\nand selects the specified menu item.\r\n@param listName Name of the related list (e.g. \"Contact Roles\", \"Products\").\r\n@param actionName Name of the action in the dropdown menu (e.g. \"Add Contact Roles\").\r\n",
				"type": "",
				"returns": "",
				"signature": "/**string*/ listName, /**string*/ actionName",
				"paramInfo": {},
				"src": "%WORKDIR%PageObjects\\Sfdc\\Sfdc.js(870,10)"
			},
			{
				"name": "RelatedListItemAction",
				"description": "Clicks an action from a specific item's dropdown menu within a Related List.\r\n@param listName Name of the related list (e.g. \"Products\", \"Contact Roles\").\r\n@param itemName Name/text of the item row (e.g. \"AutoProduct Basic\").\r\n@param actionName Name of the action in the row dropdown (e.g. \"Edit\", \"Delete\").\r\n",
				"type": "",
				"returns": "",
				"signature": "/**string*/ listName, /**string*/ itemName, /**string*/ actionName",
				"paramInfo": {},
				"src": "%WORKDIR%PageObjects\\Sfdc\\Sfdc.js(926,10)"
			},
			{
				"name": "VerifyRecordTitle",
				"description": "Verifies the record page header: entity type and record name.\r\n@param entityName Expected entity label (e.g. \"Account\", \"Lead\", \"Opportunity\").\r\n@param recordName Expected record name (e.g. \"Acme Corp\").\r\n",
				"type": "",
				"returns": "",
				"signature": "/**string*/ entityName, /**string*/ recordName",
				"paramInfo": {},
				"src": "%WORKDIR%PageObjects\\Sfdc\\Sfdc.js(992,10)"
			},
			{
				"name": "VerifyModalTitle",
				"description": "Verifies the title of a modal dialog.\r\n@param title Expected modal title text (e.g. \"New Lead\", \"New Account\").\r\n",
				"type": "",
				"returns": "",
				"signature": "/**string*/ title",
				"paramInfo": {},
				"src": "%WORKDIR%PageObjects\\Sfdc\\Sfdc.js(1044,10)"
			},
			{
				"name": "SearchModalTable",
				"description": "Searches and selects an item in a modal table (e.g. Add Products dialog).\r\nTargets the autocomplete combobox input inside the modal, types the value,\r\nwaits for results, and selects the matching item.\r\n@param value Text to search for and select.\r\n",
				"type": "",
				"returns": "",
				"signature": "/**string*/ value",
				"paramInfo": {},
				"src": "%WORKDIR%PageObjects\\Sfdc\\Sfdc.js(1077,10)"
			},
			{
				"name": "VerifyFieldInvalid",
				"description": "Verifies that a form field is in an invalid state (has validation error).\r\n@param name Field label text (e.g. \"Last Name\", \"Company\").\r\n",
				"type": "",
				"returns": "",
				"signature": "/**string*/ name",
				"paramInfo": {},
				"src": "%WORKDIR%PageObjects\\Sfdc\\Sfdc.js(1102,10)"
			},
			{
				"name": "InlineEdit",
				"description": "Clicks the inline edit pencil icon for a given field on a record detail page.\r\n@param name Field label (e.g. \"Website\", \"Phone\", \"Company\").\r\n",
				"type": "",
				"returns": "",
				"signature": "/**string*/ name",
				"paramInfo": {},
				"src": "%WORKDIR%PageObjects\\Sfdc\\Sfdc.js(1121,10)"
			},
			{
				"name": "UploadFile",
				"description": "Uploads a file to a related list's file input on the current record page.\r\n@param relatedListName Name of the related list (e.g. \"Notes & Attachments\"). Defaults to \"Notes & Attachments\" if empty.\r\n@param fileName Relative path to the file to upload (resolved via Global.GetFullPath).\r\n@returns {boolean} true on success, false if the file input was not found.\r\n",
				"type": "",
				"returns": "",
				"signature": "/**string*/ relatedListName, /**string*/ fileName",
				"paramInfo": {},
				"src": "%WORKDIR%PageObjects\\Sfdc\\Sfdc.js(1144,10)"
			},
			{
				"name": "VerifyAttachmentExists",
				"description": "Verifies that an attachment with the given name exists in a related list.\r\n@param relatedListName Name of the related list (e.g. \"Notes & Attachments\").\r\n@param name Expected attachment file name (without extension).\r\n@returns {boolean} true if the attachment is found, false otherwise.\r\n",
				"type": "",
				"returns": "",
				"signature": "/**string*/ relatedListName, /**string*/ name",
				"paramInfo": {},
				"src": "%WORKDIR%PageObjects\\Sfdc\\Sfdc.js(1202,10)"
			},
